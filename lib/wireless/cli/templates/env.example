# 用户配置目录或显式路径中的 .env；不要提交真实凭据。
# CLI > 进程环境 > YAML > .env > 默认；不修改进程 ENV。
# 密码含 #、$ 时用单引号，保留原始内容。
# HTTP 清单：
# ND_URL=https://netdisco.example.invalid
# ND_USERNAME=inventory-reader
# ND_PASSWORD='replace-me'
# 或 ND_API_KEY='replace-me'
# PostgreSQL 清单：
# ND_DB_HOST=db.example.invalid
# ND_DB_NAME=netdisco
# ND_DB_USER=inventory-reader
# ND_DB_PASS='replace-me'
# 通用设备凭据，用户名必须明确；省略密码可使用 SSH key/agent。
# NC_DEVICE_USERNAME=operator
# NC_DEVICE_PASSWORD='replace-me'
# NC_ENABLE_PASSWORD='replace-me'
# 按厂商覆盖：
# NC_H3C_WIRELESS_USERNAME=operator
# NC_H3C_WIRELESS_PASSWORD='replace-me'
# NC_HUAWEI_USERNAME=operator
# NC_HUAWEI_PASSWORD='replace-me'
# 公共配置；进程环境优先于 YAML，.env 低于 YAML：
# NC_PARALLEL=4
# NC_HOST_KEY_POLICY=accept_new
# NC_KNOWN_HOSTS=~/.ssh/known_hosts
# ND_CACHE_TTL=259200
# WIRELESS_CONFIG=wireless.yml
# WIRELESS_DIRECTORY=wireless-reports
# WIRELESS_PLATFORM=h3c
# WIRELESS_PARALLEL=4
# 显式请求 lldp 时使用的独立 AP 凭据，不继承控制器密码：
# WIRELESS_AP_USERNAME=operator
# WIRELESS_AP_PASSWORD='replace-me'
